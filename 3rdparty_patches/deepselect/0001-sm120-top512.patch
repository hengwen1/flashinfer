diff --git a/csrc/sm120_topk512.cu b/csrc/sm120_topk512.cu
new file mode 100644
index 0000000..8e01d40
--- /dev/null
+++ b/csrc/sm120_topk512.cu
@@ -0,0 +1,20 @@
+#include "cuda_kernels/v3/topk_select.cuh"
+
+using Sm120Topk512Config = TopkSelectConfig<
+    nv_bfloat16, int32_t, false, false, false, 512, 256, 1, 4096, 4096, 2>;
+
+bool sm120_topk512_available() {
+    using Kernel = topk_select_bf16_normal::TopkSelectKernelBF16Normal<Sm120Topk512Config>;
+    cudaFuncAttributes attributes;
+    auto status = cudaFuncGetAttributes(&attributes, topk_select_bf16_normal::topk_kernel<Kernel>);
+    if (status == cudaErrorNoKernelImageForDevice || status == cudaErrorInvalidDeviceFunction) {
+        cudaGetLastError();
+        return false;
+    }
+    KU_CUDA_CHECK(status);
+    return true;
+}
+
+void run_sm120_bf16_topk512(const TopkSelectArgs &args) {
+    topk_select_bf16_normal::run_topk_select_kernel<Sm120Topk512Config>(args);
+}
